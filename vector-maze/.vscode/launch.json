{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Webots 3D Maze",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/launch_webots.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Maze simulation",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_simulation.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Maze simulation (headless)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_simulation.py",
      "args": [
        "--headless"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Perception demo",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_perception_demo.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Perception demo (headless)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_perception_demo.py",
      "args": [
        "--headless"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Webots camera map + perception debug",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/launch_webots.py",
      "args": [
        "--vision-map",
        "--run",
        "--perception-debug"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
