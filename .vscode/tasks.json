{
  "version": "2.0.0",
  "tasks": [
    {"label": "Start Backend", "type": "process", "command": "${workspaceFolder}/.venv/Scripts/python.exe", "args": ["scripts/start_backend.py"], "problemMatcher": []},
    {"label": "Start Frontend", "type": "shell", "command": "npm.cmd run dev", "options": {"cwd": "${workspaceFolder}/frontend"}, "problemMatcher": []},
    {"label": "Launch Webots", "type": "process", "command": "${workspaceFolder}/.venv/Scripts/python.exe", "args": ["scripts/launch_webots.py", "--invite", "${input:invite}"], "problemMatcher": []},
    {"label": "Run Tests", "type": "process", "command": "${workspaceFolder}/.venv/Scripts/python.exe", "args": ["-m", "pytest", "-q"], "group": "test", "problemMatcher": []},
    {"label": "Start Robotic Mind Demo", "type": "process", "command": "powershell.exe", "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "scripts/start_demo.ps1"], "problemMatcher": []}
  ],
  "inputs": [{"id": "invite", "type": "promptString", "description": "Space invite from seed_demo.py (RM-XXXXXX)"}]
}
